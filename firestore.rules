rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isAdmin() { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isParent() { return role() == 'parent'; }
    function teaches(classId) {
      return isTeacher()
        && request.auth.token.classIds is list
        && classId in request.auth.token.classIds;
    }

    match /students/{studentId} {
      allow read: if isAdmin()
        || (resource.data.classId is string && teaches(resource.data.classId))
        || (isParent() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if isAdmin()
        || (resource.data.classId is string && teaches(resource.data.classId))
        || (isParent() && resource.data.parentUid == request.auth.uid);
      allow create, update: if isAdmin()
        || (request.resource.data.classId is string && teaches(request.resource.data.classId));
      allow delete: if isAdmin();
    }

    match /fees/{feeId} {
      allow read: if isAdmin()
        || (isParent() && resource.data.parentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.audience in ['all', 'teachers'])
        || (isParent() && resource.data.audience in ['all', 'parents']);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}